# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Storage backend ---
# sqlite (default, local/offline) | supabase (production)
PP_STORE_BACKEND=sqlite
# PP_SQLITE_PATH=/absolute/path/to/pulse.db   # optional override

# --- Supabase (only needed when PP_STORE_BACKEND=supabase) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Telegram ---
# Create a bot with @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Set-and-forget mode ---
# off = no daily Kite-login reminder. Sync holdings once (or manage the list via
# /add in Telegram) and the system runs hands-free: filings, news and DMA alerts
# don't need the broker session. Default: on.
PP_AUTH_NUDGE=on

# --- Anthropic (summariser) ---
ANTHROPIC_API_KEY=

# --- Zerodha broker connection ---
# DEFAULT: Kite MCP — no API app/key needed. Just run:
#     python -m portfolio_pulse.jobs.mcp_sync
# and tap the "Login with Kite" link it prints. Leave the keys below empty.
# KITE_MCP_URL=https://mcp.kite.trade/mcp     # override only for self-hosting
#
# OPTIONAL: Kite Connect API (developers.kite.trade). Only needed if you prefer
# the API path; when set, it takes precedence over MCP.
KITE_API_KEY=
KITE_API_SECRET=
